<%- include("partials/header") %>

<h2>New Message</h2>

<form method="POST" action="/new" class="message-form">
  <div class="field">
    <label for="messageUser">Name:</label>
    <input type="text" id="messageUser" name="messageUser" required />
  </div>

  <div class="field">
    <label for="messageText">Message:</label>
    <textarea id="messageText" name="messageText" rows="4" required></textarea>
  </div>

  <button type="submit">Submit</button>
</form>

<p><a href="/">&larr; Back to messages</a></p>

<%- include("partials/footer") %>